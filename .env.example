# Arbitrum Sepolia RPC. Defaults to the public endpoint (rate-limited); a free Alchemy/Infura key is better.
ARBITRUM_SEPOLIA_RPC_URL=

# Your wallet: deploys the contracts and places orders from the client CLI. Never commit a real key.
PRIVATE_KEY=

# Deployment: receives protocol fees (defaults to the deployer).
FEE_COLLECTOR=

# Checker: any funded key; it pays gas for checks, executes, settles, re-arms and reconciles.
CHECKER_PRIVATE_KEY=
CHECKER_POLL_MS=10000
# First L2 block to scan for orders if contracts/broadcast has no receipts.
START_BLOCK=
