# Arbitrum Sepolia RPC. Fork tests fall back to the public endpoint if unset (rate-limited).
ARBITRUM_SEPOLIA_RPC_URL=

# Deployer / test account for live Sepolia runs. Never commit a real key.
PRIVATE_KEY=

# Chainlink Data Streams credentials, used by the checker to fetch reports.
DATA_STREAMS_API_KEY=
DATA_STREAMS_API_SECRET=
